#!/usr/bin/env bash
# bromodachi launcher.
#   bromodachi summon   show the buddy, or toggle keyboard focus on the answer box
#   bromodachi cycle    switch to the next character (live if he's up)
#   bromodachi hide     force-close the buddy (bypasses the answer gate)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QML="$DIR/shell.qml"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bromodachi"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/bromodachi/config.json"
mkdir -p "$STATE_DIR"

# write a default config on first run
if [[ ! -f "$CONFIG" ]]; then
    mkdir -p "$(dirname "$CONFIG")"
    printf '{\n  "autofocus": true\n}\n' > "$CONFIG"
fi

pid()   { pgrep -f "^qs -p $QML" || true; }
ipc()   { qs ipc --pid "$1" call buddy "${@:2}"; }
start() {
    local autofocus
    autofocus=$(python3 -c '
import json, sys
try:
    print(1 if json.load(open(sys.argv[1])).get("autofocus") else 0)
except Exception:
    print(0)
' "$CONFIG")
    BUDDY="$(cat "$STATE_DIR/current" 2>/dev/null || true)" \
    BUDDY_AUTOFOCUS="$autofocus" \
        setsid qs -p "$QML" >/dev/null 2>&1 &
}

case "${1:-summon}" in
    summon|toggle)
        p=$(pid)
        if [[ -n "$p" ]]; then ipc "$p" focus; else start; fi
        ;;
    cycle)
        case "$(cat "$STATE_DIR/current" 2>/dev/null || true)" in
            shiba) next=robot ;;
            robot) next=ninja ;;
            *)     next=shiba ;;
        esac
        echo "$next" > "$STATE_DIR/current"
        p=$(pid)
        if [[ -n "$p" ]]; then ipc "$p" setCharacter "$next"; else start; fi
        ;;
    hide)
        pkill -f "^qs -p $QML" || true
        ;;
    *)
        echo "usage: bromodachi [summon|cycle|hide]" >&2
        exit 1
        ;;
esac
