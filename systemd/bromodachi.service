# User service for the bromodachi daemon.
#   install: systemctl --user link $PWD/systemd/bromodachi.service
# Do NOT enable: ~/.config/hypr/autostart.lua starts it each session AFTER
# importing WAYLAND_DISPLAY / HYPRLAND_INSTANCE_SIGNATURE into the user
# manager (the signature changes every Hyprland restart, so a boot-time
# start would inherit a stale one). Restart=on-failure means a crashed
# daemon comes back with a fresh schedule; state lives in Postgres.
[Unit]
Description=Bromodachi pixel-buddy daemon
After=graphical-session.target

[Service]
ExecStart=%h/lab/bromodachi/target/release/bromodachi daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
